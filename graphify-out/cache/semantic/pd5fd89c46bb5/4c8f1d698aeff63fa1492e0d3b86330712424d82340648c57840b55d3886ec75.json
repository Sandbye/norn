{"nodes": [{"id": "claude_architecture", "label": "norn package architecture", "file_type": "document", "source_file": "CLAUDE.md", "source_location": "architecture", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "cmd/work/main.go routes CLI args; internal/{config,git,tui,prompt,review} separate config loading, git operations, Bubble Tea views, template rendering and the review model."}, {"id": "claude_composable_config", "label": "Composable config (global + per-project)", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": "key design decisions 1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Global defaults plus per-repo .work.yaml overrides, so no repo-specific knowledge is hardcoded into the binary."}, {"id": "claude_remote_branch_check", "label": "Remote branch check in clean", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "key design decisions 2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "git fetch --prune then existence check on origin/<branch> yields a gone/active flag per worktree, which is the real signal for whether a worktree is safe to delete."}, {"id": "claude_age_from_last_commit", "label": "Age from last commit, not filesystem mtime", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": "key design decisions 3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Commit date is a more meaningful staleness measure than mtime, which any build or editor touch would reset."}, {"id": "claude_direct_create_shortcut", "label": "Direct create shortcut", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "key design decisions 4", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "work \"hint\" bypasses the TUI entirely and picks the first base branch, optimizing the common fast-path over generality."}, {"id": "claude_execprocess_handoff", "label": "ExecProcess terminal handoff to the agent", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "key design decisions 5", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "tea.ExecProcess hands terminal control to Claude so the alt screen exits cleanly instead of fighting the agent for the TTY."}, {"id": "claude_prompt_template_rendering", "label": "Prompt generation via text/template", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "key design decisions 6", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "internal/prompt renders .worktree.md from config plus a selected template. Precedence is --template flag, then cfg.template (task), then kind; user overrides live in ~/.config/work/templates."}, {"id": "claude_one_review_flow_two_sinks", "label": "One review flow, two sinks", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": "key design decisions 7", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The diff view's comment machinery is shared: PR mode POSTs to GitHub, local mode writes .norn/review.md and offers to resume the agent. Comments carry a conventional-comment label and blocking flag rendered into the body for both sinks, so there is one keymap to learn."}, {"id": "claude_conventions", "label": "Repo contribution conventions", "file_type": "document", "source_file": "CLAUDE.md", "source_location": "conventions", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Conventional Commits title-only by default with a body only when the why is non-obvious; Conventional Branch <type>/<title>; concise PRs with no test-plan section unless asked."}], "edges": [{"source": "readme_clean_tab", "target": "claude_remote_branch_check", "relation": "implements", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "CLAUDE.md", "source_location": "key design decisions 2", "weight": 1.0}, {"source": "readme_threads_tab", "target": "claude_age_from_last_commit", "relation": "implements", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "CLAUDE.md", "source_location": "key design decisions 3", "weight": 1.0}, {"source": "readme_templates", "target": "claude_prompt_template_rendering", "relation": "implements", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "CLAUDE.md", "source_location": "key design decisions 6", "weight": 1.0}, {"source": "readme_configurable_agent", "target": "claude_execprocess_handoff", "relation": "implements", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "CLAUDE.md", "source_location": "key design decisions 5", "weight": 1.0}, {"source": "readme_zero_config", "target": "claude_composable_config", "relation": "implements", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "CLAUDE.md", "source_location": "key design decisions 1", "weight": 1.0}, {"source": "readme_local_review", "target": "claude_one_review_flow_two_sinks", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "CLAUDE.md", "source_location": "key design decisions 7", "weight": 1.0}, {"source": "claude_architecture", "target": "claude_prompt_template_rendering", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "CLAUDE.md", "source_location": "architecture", "weight": 1.0}, {"source": "claude_architecture", "target": "claude_one_review_flow_two_sinks", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "CLAUDE.md", "source_location": "architecture", "weight": 1.0}, {"source": "claude_direct_create_shortcut", "target": "claude_composable_config", "relation": "shares_data_with", "confidence": "INFERRED", "confidence_s